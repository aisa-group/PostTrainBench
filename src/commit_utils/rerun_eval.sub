executable = /bin/bash
num_gpus = 1
# Empty: the final evaluation's default seeds. Other seeds: -a "seed_args=--seeds <seed>...".
seed_args =
arguments = scripts/rerun_eval_n_times.sh $(eval_dir) $(seed_args)
# Only HOME: everything else comes from .env. ($ENV(X) of a variable the submitting shell lacks is "UNDEFINED",
# which set_env_vars.sh would not replace.)
environment = "HOME=$ENV(HOME)"
error = logs/rerun_$(Cluster).err
output = logs/rerun_$(Cluster).out
log = logs/rerun_$(Cluster).log
request_memory = 131072
request_cpus = 16
request_gpus = $(num_gpus)
requirements = TARGET.CUDADeviceName == "NVIDIA H100 80GB HBM3" && Machine != "i104.internal.cluster.is.localnet"
request_disk=400G
+BypassLXCfs="true"
queue
