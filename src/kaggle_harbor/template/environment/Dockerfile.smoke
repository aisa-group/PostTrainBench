# SMOKE IMAGE — NOT the image that ships.
#
# build_tasks.py installs this in place of environment/Dockerfile only when
# --smoke is passed, and stamps smoke_build = true into task.toml and
# tests/metadata.json so a smoke task can never be mistaken for a real one.
#
# The real image (environment/Dockerfile, a port of containers/standard.def)
# is a ~20 GB CUDA build: vllm, flash-attn compiled from source, torch on
# cu12.9. It cannot even be built on a machine without an NVIDIA driver,
# because `--torch-backend=auto` resolves to CPU torch and then fails vllm's
# CUDA-only xformers dependency.
#
# That makes it useless for iterating on the parts of this port that are not
# the ML stack at all — the sandbox layout, the healthcheck gate, timer.sh,
# how the instruction reaches the agent, the artifact transfer into a
# separate verifier, the judge invocation and the reward contract. Those are
# exactly the parts with no upstream counterpart and therefore the ones most
# likely to be wrong.
#
# So this image keeps everything structural identical to the real one —
# same /home/ben layout, same staged files, same env, same WORKDIR, same
# preflight.sh — and drops only the ML stack. What it cannot exercise:
# training, evaluate.py, and anything that needs a GPU.

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/root/.local/bin:$PATH"
ENV NO_PROXY="localhost,127.0.0.1"
ENV no_proxy="localhost,127.0.0.1"
ENV HOME=/home/ben

RUN chmod 1777 /tmp

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        git \
        curl \
        ca-certificates \
        procps \
        tree \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3 /usr/bin/python

RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && rm -rf /var/lib/apt/lists/*

# Identical to the real image from here down.
COPY home/ /home/ben/
COPY preflight.sh /usr/local/bin/preflight.sh
RUN chmod +x /usr/local/bin/preflight.sh && \
    chmod -R a+rw /home/ben && \
    mkdir -p /home/ben/hf_cache

WORKDIR /home/ben/task
