# SMOKE VERIFIER IMAGE — NOT the image that ships.
# See environment/Dockerfile.smoke for why this exists.
#
# Keeps the codex CLI, because whether the judges can authenticate against
# the Kaggle model proxy is a real open question this image can answer.
# Drops vllm / inspect_evals, so evaluate.py fails and score_run.py takes
# collect.py's baseline-fallback path — which is itself worth exercising.

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/root/.local/bin:$PATH"
ENV NO_PROXY="localhost,127.0.0.1"
ENV no_proxy="localhost,127.0.0.1"
ENV HOME=/home/ben

RUN chmod 1777 /tmp

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        git \
        curl \
        ca-certificates \
        procps \
        tree \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3 /usr/bin/python

RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && rm -rf /var/lib/apt/lists/*

# gpt_5_5.def's pin, same as the real verifier image.
RUN npm install -g @openai/codex@0.124.0

COPY . /tests/
RUN rm -f /tests/Dockerfile /tests/Dockerfile.smoke /tests/requirements-direct.txt && \
    chmod +x /tests/test.sh

WORKDIR /tests
