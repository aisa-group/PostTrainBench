# API Keys
OPENAI_API_KEY="your-openai-key"
ANTHROPIC_API_KEY="your-anthropic-key"
GEMINI_API_KEY="your-gemini-key"
OPENCODE_API_KEY="your-opencode-key"
OPENROUTER_API_KEY="your-openrouter-key"
GLMX_API_KEY="your-zai-key"

# Paths
HF_HOME="$HOME/.cache/huggingface"
POST_TRAIN_BENCH_RESULTS_DIR="results"
POST_TRAIN_BENCH_CONTAINERS_DIR="containers"
MY_HF_TOKEN="token"
# File of extra secrets to redact from extracted traces (dev_utils/extract_traces.py).
# One secret per line; blank lines and lines starting with '#' are ignored.
POST_TRAIN_BENCH_SANITIZATION_SECRETS="$HOME/secrets/api_keys.txt"

# Config
POST_TRAIN_BENCH_CONTAINER_NAME="standard"
POST_TRAIN_BENCH_PROMPT="prompt"
POST_TRAIN_BENCH_JOB_SCHEDULER="htcondor_mpi-is"
